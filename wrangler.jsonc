{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "depmap-mcp-server",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"alias": {
		"ai": "./src/ai-stub.ts"
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"DepMapDataDO"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"MyMCP"
			],
			"tag": "v2"
		},
		{
			"tag": "mcp-2026-07-28-stateless",
			"deleted_classes": ["MyMCP"]
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "DepMapDataDO",
				"name": "DEPMAP_DATA_DO"
			}]
	},
	"worker_loaders": [
		{
			"binding": "CODE_MODE_LOADER"
		}
	],
	"triggers": {
		"crons": [
			"0 11 * * *"
		]
	},
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8816
	}
}
